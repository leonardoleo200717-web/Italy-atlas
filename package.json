    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "fflate": "0.8.3",
    "globals": "16.5.0",
    "mapshaper": "0.7.101",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
