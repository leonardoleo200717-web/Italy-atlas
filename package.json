    "data:validate:strict": "tsx pipeline/validate.ts --strict",
    "data:build": "tsx pipeline/build.ts"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
